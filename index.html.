11px 0}td:last-child,th:last-child{text-align:right}td:last-child{font-weight:bold}td:not(:first-child),th:not(:first-child){padding-left:15px}ul{padding-left:23px;margin:10px 0}li{margin:8px 0}.note{font-size:16px;line-height:1.4;color:#777;margin-top:17px}.footer{margin-top:auto;padding-top:20px;font-size:13px;color:#888;display:flex;justify-content:space-between}.lead{font-size:33px;line-height:1.3;margin-top:22px;max-width:680px}.question{font-size:28px;line-height:1.4;margin-top:25px;max-width:660px}.proof{margin-top:auto;display:grid;grid-template-columns:1.2fr 1fr 1fr;border-top:1px solid #ccc;padding-top:30px;margin-bottom:25px}.metric{padding:0 20px}.metric:first-child{padding-left:0}.metric+.metric{border-left:1px solid #ddd}.metric strong{display:block;font-size:49px;letter-spacing:-2px;white-space:nowrap}.metric span{display:block;font-size:19px;color:#777;margin-top:9px}.bar{display:flex;height:88px;margin:20px 0 0;border:1px solid #aaa}.bar div{display:flex;align-items:center;justify-content:center;font-size:30px;font-weight:bold}.bar div:first-child{width:43.3%;background:#e8e8e4;color:#333}.bar div:last-child{width:56.7%;background:#444;color:white}.bar-labels{display:grid;grid-template-columns:43.3fr 56.7fr;margin:12px 0 26px;font-size:19px;gap:12px}.bar-labels span:last-child{text-align:right}.all-label{margin-top:24px;font-size:21px;font-weight:bold}.recommendation{font-size:29px;line-height:1.35;margin-top:10px}.cta{border-top:1px solid #aaa;padding-top:28px;margin-top:auto;font-size:39px;line-height:1.15;letter-spacing:-1px;font-weight:bold}.cta p{font-size:21px;font-weight:normal;letter-spacing:0;color:#777;line-height:1.4;margin-top:16px}.closing-item{padding:22px 0;border-bottom:1px solid #ddd}.closing-item strong{display:block;font-size:27px;margin-bottom:7px}.compact .body{font-size:21px}.compact h2{font-size:41px}.compact td{padding:9px 0}.compact li{margin:6px 0}.dots{text-align:center;margin:18px 0}.dots button{margin:3px;padding:7px 10px}.dots .active{background:#333;color:white}.all{max-width:1400px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.all .frame{cursor:pointer}.caption{text-align:center;color:#888;font-size:12px;margin:15px}@media(max-width:900px){.all{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:550px){.all{grid-template-columns:1fr}header{padding:12px}main{margin-top:15px}}@media print{header,.dots,.caption{display:none}.all{display:block}main{padding:0;margin:0}.frame{break-after:page;box-shadow:none}}</style></head><body><header><strong>The Cold Email Report · Q3 2026 · Wireframe</strong><div><button id="prev" aria-label="Previous slide">←</button><span id="count" aria-live="polite"></span><button id="next" aria-label="Next slide">→</button> <button id="view">View all slides</button></div></header><main id="main"></main><nav class="dots" id="dots" aria-label="Slide navigation"></nav><p class="caption">Use the arrows or keyboard to navigate. Select a slide in overview to open it.</p><script>const slides=[
['',`<h1>The Cold<br>Email Report</h1><p class="lead">We analyzed <strong>30M+ emails</strong> in the last three months of outreach.</p><p class="question">Take a closer look at what the findings mean for your next campaign.</p><div class="proof"><div class="metric"><strong>30M+</strong><span>Emails</span></div><div class="metric"><strong>2,906</strong><span>Users</span></div><div class="metric"><strong>39,800</strong><span>Mailboxes</span></div></div>`],
['Follow up replies',`<h2>Follow ups accounted for more than 50% of all replies.</h2><div class="body"><div class="label">Insight</div><p>Your first email result does not show how the complete sequence performed.</p><div class="all-label">Out of every 100 replies we analyzed</div><div class="bar" role="img" aria-label="Distribution per 100 replies: first email 43.3 percent; all follow ups combined 56.7 percent."><div>43.3%</div><div>56.7%</div></div><div class="bar-labels"><span>First email<br><strong>43.3% of all replies</strong></span><span>All follow ups combined<br><strong>56.7% of all replies</strong></span></div><div class="action"><div class="label">What to do</div><p class="recommendation"><strong>Build a sequence with at least 4 follow ups.</strong></p><ul><li>Share a relevant customer example.</li><li>Explain a specific benefit.</li><li>Answer a common question.</li><li>Ask one clear question.</li></ul><p><strong>Add a reason to respond, not just another reminder.</strong></p></div></div>`],
['Follow up breakdown',`<h2>Emails two and three together received more replies than the first.</h2><div class="body"><div class="label">Insight</div><p><strong>How every 100 replies were distributed</strong></p><table><tr><th>Email</th><th>Share of those 100 replies</th></tr><tr><td>First</td><td>43.3%</td></tr><tr><td>Second</td><td>29.0%</td></tr><tr><td>Third</td><td>15.3%</td></tr><tr><td>Fourth</td><td>7.3%</td></tr><tr><td>Fifth</td><td>2.9%</td></tr><tr><td>Sixth onward</td><td>2.1%</td></tr></table><p>Emails two and three together accounted for <strong>44.3% of replies</strong>, compared with <strong>43.3%</strong> for the first.</p><div class="action"><div class="label">What to do</div><ul><li>Share a customer example relevant to the prospect.</li><li>Answer a common question about your offer.</li><li>Make the next step clear and easy to respond to.</li></ul><p><strong>Add a reason to respond, not another reminder.</strong></p></div></div>`,'compact'],
['Address verification',`<h2>Addresses marked bad bounced nearly nine times more often.</h2><div class="body"><div class="label">Insight</div><p><strong>10.58%</strong> for addresses marked bad, compared with <strong>1.21%</strong> for valid addresses.</p><table><tr><th>Recorded address status</th><th>Bounce rate</th></tr><tr><td>Valid</td><td>1.21%</td></tr><tr><td>Unverified</td><td>2.11%</td></tr><tr><td>Risky</td><td>2.22%</td></tr><tr><td>Bad</td><td>10.58%</td></tr></table><p>Bad addresses had <strong>nearly nine times</strong> the observed bounce rate of valid addresses.</p><div class="action"><div class="label">What to do</div><ul><li>Exclude addresses that fail verification.</li><li>Check addresses with no verification result.</li><li>Review risky results before including them.</li><li>Confirm that your final sending list reflects those decisions.</li></ul></div><p class="note">Recorded statuses may not capture verification done outside Saleshandy.</p></div>`,'compact'],
['Delivery monitoring',`<h2>Valid addresses can still bounce.</h2><div class="body"><div class="label">Insight</div><p>Addresses marked valid still recorded a <strong>1.21% bounce rate.</strong></p><p>Passing verification does not mean every email you send will reach its recipient.</p><div class="action"><div class="label">What to do</div><p>After launching:</p><ul><li>Check which addresses and mailboxes record bounces.</li><li>Read the failure messages.</li><li>Remove addresses confirmed as invalid.</li><li>Investigate repeated failures before continuing with the same setup.</li></ul><p><strong>Keep monitoring delivery after checking the list.</strong></p></div></div>`],
['Bounce reasons',`<h2>More than one third of bounces were related to blocks.</h2><div class="body"><div class="label">Insight</div><p>Across the study, <strong>1.93% of emails bounced.</strong></p><p>Among those bounced emails:</p><table><tr><th>Recorded bounce type</th><th>Share</th></tr><tr><td>Hard bounces</td><td>63%</td></tr><tr><td>Bounces related to blocks</td><td>37%</td></tr></table><p><strong>More than one in three recorded bounces was related to a block.</strong></p><div class="action"><div class="label">What to do</div><ul><li>Check the stated reason for the failure.</li><li>Remove confirmed invalid addresses.</li><li>Investigate blocked messages separately.</li><li>Check whether the same failure affects several mailboxes.</li></ul><p>Another list verification check may not resolve a block.</p></div></div>`],
['Provider comparison',`<h2>Google Workspace and Office 365 both had bounce rates above 2%.</h2><div class="body"><div class="label">Insight</div><p>Here is how selected providers compared in this study:</p><table><tr><th>Sending provider</th><th>Emails sent</th><th>Bounce rate</th></tr><tr><td>Google Workspace</td><td>12.49M</td><td>2.06%</td></tr><tr><td>Office 365</td><td>7.93M</td><td>2.39%</td></tr><tr><td>Zoho</td><td>462K</td><td>1.73%</td></tr><tr><td>GoDaddy</td><td>104K</td><td>6.68%</td></tr></table><p>These groups used different lists and sending setups. The figures do not isolate the provider’s effect.</p><div class="action"><div class="label">What to do</div><p>Before moving your mailboxes:</p><ul><li>Compare results separately for each provider you use.</li><li>Check whether failures affect one mailbox or several.</li><li>Review the bounce reasons before choosing a replacement.</li></ul><p><strong>Use the comparison to investigate your setup, not as a guaranteed provider ranking.</strong></p></div></div>`,'compact'],
['Reply rate breakdown',`<h2>Only 25% of users had reply rates above 2.77%.</h2><div class="body"><div class="label">Insight</div><p>Here’s how reply rates were distributed:</p><table><tr><th>Reply rate</th><th>Approximate share of users</th></tr><tr><td>1.07% or lower</td><td>50%</td></tr><tr><td>Above 1.07%, up to 2.77%</td><td>25%</td></tr><tr><td>Above 2.77%</td><td>25%</td></tr></table><div class="action"><div class="label">What to do</div><ul><li>Record your current reply rate before making changes.</li><li>Test one change to your audience or message at a time.</li><li>Check whether the next version produces more interested conversations.</li></ul></div></div>`,'compact'],
['Your next campaign',`<h2>Use the findings in your next campaign.</h2><div class="body"><div class="closing-item"><strong>Prepare the complete sequence.</strong>Plan at least 4 follow ups, each adding something useful.</div><div class="closing-item"><strong>Make verification affect your sending list.</strong>Exclude failed addresses and review uncertain results.</div><div class="closing-item"><strong>Investigate delivery failures.</strong>Check bounce reasons before changing your list or provider.</div></div><div class="cta"><div class="label">Get the full picture</div>Read The Cold Email Report<p>Explore the complete findings and how they were measured.</p><p>30M+ emails analyzed · Q3 2026</p></div>`]
];let index=0,all=false;const main=document.getElementById('main'),dots=document.getElementById('dots');const observer=new ResizeObserver(entries=>entries.forEach(({target})=>{const w=target.clientWidth;target.style.height=w*1.25+'px';target.firstElementChild.style.transform='scale('+w/900+')'}));function frame(i){const f=document.createElement('div');f.className='frame';f.innerHTML='<article class="slide '+(slides[i][2]||'')+'"><div class="top"><span class="brand">Saleshandy</span><span>THE COLD EMAIL REPORT · Q3 2026</span></div>'+(slides[i][0]?'<div class="tag">'+slides[i][0]+'</div>':'')+slides[i][1]+'<div class="footer"><span>Saleshandy Outreach Research · Q3 2026</span><span>'+String(i+1).padStart(2,'0')+' / 09</span></div></article>';observer.observe(f);return f}function render(){observer.disconnect();main.replaceChildren();main.className=all?'all':'';if(all){slides.forEach((s,i)=>{const f=frame(i);f.tabIndex=0;f.setAttribute('aria-label','Open slide '+(i+1));f.onclick=()=>{index=i;all=false;render();window.scrollTo(0,0)};f.onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();f.click()}};main.appendChild(f)})}else main.appendChild(frame(index));document.getElementById('count').textContent=all?'9 slides':(index+1)+' / 9';document.getElementById('prev').disabled=all||index===0;document.getElementById('next').disabled=all||index===8;document.getElementById('view').textContent=all?'Single slide':'View all slides';document.getElementById('view').setAttribute('aria-pressed',String(all));dots.style.display=all?'none':'';dots.replaceChildren();slides.forEach((s,i)=>{const b=document.createElement('button');b.textContent=i+1;b.className=i===index?'active':'';b.setAttribute('aria-label','Slide '+(i+1)+(s[0]?': '+s[0]:''));b.onclick=()=>{index=i;render()};dots.appendChild(b)})}document.getElementById('prev').onclick=()=>{index=Math.max(0,index-1);render()};document.getElementById('next').onclick=()=>{index=Math.min(8,index+1);render()};document.getElementById('view').onclick=()=>{all=!all;render()};document.addEventListener('keydown',e=>{if(all)return;if(e.key==='ArrowRight'){e.preventDefault();index=Math.min(8,index+1);render()}if(e.key==='ArrowLeft'){e.preventDefault();index=Math.max(0,index-1);render()}});render();</script></body></html>
